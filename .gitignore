# Dependencies
node_modules/

# Scratch and review output
#
# REVIEW FRAMES MUST NOT LIVE IN THIS REPO AT ALL. They are throwaway artefacts
# of `npm run review`, they are megabytes, and one has already been committed here
# by mistake. Put them outside the tree:
#
#     node scripts/review-frames.mjs --at 94 --no-end
#     ->  C:\Users\0\.buzz\.scratch\hyperframes-review\<slug>\
#
# `npm run lint:repo` FAILS if any image or render artefact is tracked by git, and
# if a review directory is committed into the tree. See docs/WORKFLOW.md.
.scratch/
.shots/
snapshots/
review/
out/
renders/
transcripts/

# Tool output. Regenerate with `npx hyperframes lint --json > lint.json`; it is a
# report of the working tree, not source, and committing it produced diff noise on
# every commit that changed a composition.
lint.json
build-report.json

# Rendered video and audio.
#
# These are build artefacts, not source. `fetch-audio.mjs` regenerates the
# narration mp3s from narrations/*.json via Deepgram; `npm run render` produces
# the mp4s.
#
# CONSEQUENCE, stated plainly: a fresh clone will NOT have narration audio, so it
# renders silent. That is the intended trade — the repo stays free of binaries.
# Run `node fetch-audio.mjs` to regenerate before rendering.
*.mp4
*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.flac
*.webm
*.mov
*.mkv
*.avi

# Frames extracted for visual review. NOT .svg — the logo, the cursors and the
# Heroicons are source assets and the compositions fail to render without them.
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Logs, OS noise, secrets
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# HyperFrames build artifacts
.hyperframes/
hyperframes.lock.json