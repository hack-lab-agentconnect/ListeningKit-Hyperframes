{
  "name": "listeningkit-hyperframes",
  "private": false,
  "type": "module",
  "description": "ListeningKit object-explainer video series — HyperFrames compositions and the design system that governs them",
  "license": "MIT",
  "scripts": {
    "entry": "node scripts/entry.mjs",
    "dev": "npx --yes hyperframes@0.8.112 preview",
    "build": "node src/build-beats.mjs && node scripts/entry.mjs",
    "check": "npx --yes hyperframes@0.8.112 check",
    "render": "node scripts/entry.mjs && npx --yes hyperframes@0.8.112 render",
    "snapshot": "node scripts/entry.mjs && npx --yes hyperframes@0.8.112 snapshot",
    "review": "node scripts/review-frames.mjs",
    "lint": "npm run lint:design && npm run lint:pacing && npm run test:spring && npm run test:color && npm run test:camera && npm run test:pointer && npm run test:fx && npm run lint:components && npm run lint:transitions && npm run lint:docs && npm run lint:repo",
    "lint:design": "node scripts/lint-design.mjs",
    "lint:pacing": "node scripts/lint-pacing.mjs",
    "test:spring": "node scripts/test-spring.mjs",
    "test:color": "node scripts/test-color.mjs",
    "test:camera": "node scripts/test-camera.mjs",
    "lint:docs": "node scripts/lint-docs.mjs",
    "test:pointer": "node scripts/test-pointer.mjs",
    "lab:pointer": "node src/build-lab.mjs && node scripts/entry.mjs pointer-lab",
    "lab:transition": "node src/build-demo.mjs --entry",
    "lint:transitions": "node scripts/lint-transitions.mjs",
    "lint:components": "node scripts/lint-components.mjs",
    "lab:components": "node src/build-components-lab.mjs --entry",
    "test:fx": "node scripts/test-fx.mjs",
    "lint:repo": "node scripts/lint-repo.mjs",
    "audio": "node src/fetch-audio.mjs",
    "refs": "node scripts/refs.mjs",
    "times": "node scripts/narration-times.mjs"
  },
  "devDependencies": {
    "lefthook": "^1.7.0"
  }
}